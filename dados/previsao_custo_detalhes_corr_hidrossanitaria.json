, área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1157,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.1543,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.1581,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.107,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1109,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1111,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1074,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0745,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0465,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0146,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.116·ARIMA + 0.103·SARIMAX-12 + 0.113·SARIMAX-6 + 0.113·Holt-Winters + 0.021·Prophet/UC + 0.118·Theta + 0.287·GradientBoosting + 0.128·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1163,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1026,"—","—","—