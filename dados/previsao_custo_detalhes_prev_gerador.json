imilhança.","","","","",""],["Prophet/UC","Configuração","UnobservedComponents(LLT + seasonal=12 + exog)","","","","",""],["Prophet/UC","AIC",1764.88,"","","","",""],["Prophet/UC","BIC",1785.06,"","","","",""],["Prophet/UC","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",1764.8813,"—","—","—","—",""],["Prophet/UC","BIC",1785.0557,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",7211425.613,1122084.8297,0,5012139.3469,9410711.8792,"Sim"],["Prophet/UC","sigma2.level",12250.2819,111343.3073,0.9124,-205982.6005,230483.1642,"Não"],["Prophet/UC","sigma2.trend",0.0001,198.0693,1,-388.2158,388.216,"Não"],["Prophet/UC","sigma2.seasonal",425197.6614,229598.1201,0.064,-24814.654,875209.9768,"Não"],["Prophet/UC","beta.x1",-4.43,11.5318,0.7009,-27.0324,18.1724,"Não"],["Prophet/UC","beta.x2",133.3243,2445.24,0.9565,-4659.3461,4925.9947,"Não"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",-6.1932,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.0592,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.054,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0603,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0418,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0787,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.099,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.0711,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.2306,"—","—","—","—",""],["GradientBoosting","importância_mes",0.1528,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.1952,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0166,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.143·ARIMA + 0.137·SARIMAX-12 + 0.138·SARIMAX-6 + 0.113·Holt-Winters + 0.150·Prophet/UC + 0.135·Theta + 0.047·GradientBoosting + 0.137·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1427,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0