osting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.0836,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0687,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0722,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0658,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.09,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1546,"—","—","—","—",""],["GradientBoosting","importância_mes",0.2002,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.1327,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0323,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.113·ARIMA + 0.114·SARIMAX-12 + 0.116·SARIMAX-6 + 0.116·Holt-Winters + 0.088·Prophet/UC + 0.114·Theta + 0.226·GradientBoosting + 0.111·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1135,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.114,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1159,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1165,"—","—","—","—",""],["Ensemble","peso_Prophet/UC