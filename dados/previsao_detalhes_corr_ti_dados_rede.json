 letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",595.1347,"—","—","—","—",""],["Prophet/UC","BIC",617.2321,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",4.5316,0.699,0,3.1616,5.9016,"Sim"],["Prophet/UC","sigma2.level",0.3388,0.2171,0.1187,-0.0868,0.7644,"Não"],["Prophet/UC","sigma2.trend",0,0.0006,1,-0.0011,0.0011,"Não"],["Prophet/UC","sigma2.seasonal",0.1119,0.0954,0.2409,-0.0751,0.2989,"Não"],["Prophet/UC","beta.x1",0.0068,0.0046,0.1424,-0.0023,0.0158,"Não"],["Prophet/UC","beta.x2",-0.6685,0,0,-0.6685,-0.6685,"Sim"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.0409,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.2703,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.0778,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.07