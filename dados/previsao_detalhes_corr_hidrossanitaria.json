 depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.083,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0877,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0683,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0863,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.165,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1645,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1219,"—","—","—","—",""],["GradientBoosting","importância_mes",0.097,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.1152,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0109,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.136·ARIMA + 0.118·SARIMAX-12 + 0.132·SARIMAX-6 + 0.130·Holt-Winters + 0.122·Prophet/UC + 0.136·Theta + 0.092·GradientBoosting + 0.134·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1358,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.118,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1324,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.129