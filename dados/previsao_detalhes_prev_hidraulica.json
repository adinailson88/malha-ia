osting","importância_mm_3",0.0901,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1756,"—","—","—","—",""],["GradientBoosting","importância_mes",0.2938,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.178,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0238,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.136·ARIMA + 0.135·SARIMAX-12 + 0.132·SARIMAX-6 + 0.135·Holt-Winters + 0.136·Prophet/UC + 0.137·Theta + 0.046·GradientBoosting + 0.142·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1364,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1355,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1324,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1347,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.1358,"—","—","—","—",""],["Ensemble","peso_Theta",0.1369,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.046,"—","—","—","—",""],["Ensemble","peso_LSTM_Forecast",0.1423,"—","—","—","—",""]]
