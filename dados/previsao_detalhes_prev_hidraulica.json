,-0.0077,0.008,"Não"],["Prophet/UC","sigma2.trend",0,0,1,0,0,"Não"],["Prophet/UC","sigma2.seasonal",0.0025,0.0077,0.7428,-0.0125,0.0175,"Não"],["Prophet/UC","beta.x1",-0.0016,0.0015,0.276,-0.0044,0.0013,"Não"],["Prophet/UC","beta.x2",0.0471,0,0,0.0471,0.0471,"Sim"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.001,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.2517,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.0499,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0373,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0333,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0499,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.0563,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.0669,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1492,"—","—","—","—",""],["GradientBoosting","importância_mes",0.3252,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.1919,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.04,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.136·ARIMA + 0.122·SARIMAX-12 + 0.146·SARIMAX-6 + 0.125·Holt-Winters + 0.139·Prophet/UC + 0.124·Theta + 0.065·GradientBoosting + 0.143·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1362,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.122,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1457,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1247,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.1394,"—","—","—","—",""],["Ensemble","peso_Theta",0.1237,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.0651,"—","—","—","—",""],["Ensemble","peso_LSTM_Forecast",0.1432,"—","—","—","—",""]]
