ncia_mm_6",0.156,"—","—","—","—",""],["GradientBoosting","importância_mes",0.3104,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.2004,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0288,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.136·ARIMA + 0.126·SARIMAX-12 + 0.143·SARIMAX-6 + 0.124·Holt-Winters + 0.140·Prophet/UC + 0.123·Theta + 0.069·GradientBoosting + 0.138·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.136,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1256,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1426,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1244,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.1401,"—","—","—","—",""],["Ensemble","peso_Theta",0.1235,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.0695,"—","—","—","—",""],["Ensemble","peso_LSTM_Forecast",0.1384,"—","—","—","—",""]]
