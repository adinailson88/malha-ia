[["Modelo","Parâmetro","Valor","Erro Padrão","p-valor","IC95% Inf","IC95% Sup","Significativo (p<0.05)"],["ARIMA","EQUAÇÃO","ARIMA(0,1,1): y(t) = c + θ_1·ε(t-1) + ε(t) [após 1 diferenciação(ões) ordinária(s)]","","","","",""],["ARIMA","Configuração","ARIMA(0,1,1)","","","","",""],["ARIMA","AIC",106.22,"","","","",""],["ARIMA","BIC",111.56,"","","","",""],["ARIMA","Usa exógenas (chuva, letivo)","Não","","","","",""],["ARIMA","ma.L1",-1.009,0.0891,0,-1.1837,-0.8343,"Sim"],["ARIMA","sigma2",0.1451,0.0352,0,0.0761,0.2141,"Sim"],["","","","","","","",""],["Holt-Winters","EQUAÇÃO","Holt-Winters Aditivo: ℓ(t) = α·y(t) + (1-α)·[ℓ(t-1) + b(t-1)]; b(t) = β·[ℓ(t)-ℓ(t-1)] + (1-β)·b(t-1); s(t) = γ·[y(t)-ℓ(t)] + (1-γ)·s(t-12). Forecast: ŷ(t+h) = ℓ(t) + h·b(t) + s(t-12+h).","","","","",""],["Holt-Winters","Configuração","HW(α=0.000,β=0.000,γ=0.000)","","","","",""],["Holt-Winters","AIC",-188.33,"","","","",""],["Holt-Winters","BIC",-145.13,"","","","",""],["Holt-Winters","Usa exógenas (chuva, letivo)","Não","","","","",""],["Holt-Winters","α (suavização nível)",0,"—","—","—","—",""],["Holt-Winters","β (suavização tendência)",0,"—","—","—","—",""],["Holt-Winters","γ (suavização sazonal)",0,"—","—","—","—",""],["Holt-Winters","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.0007,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.2612,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.259·ARIMA + 0.231·Holt-Winters + 0.260·Theta + 0.251·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.2588,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.2305,"—","—","—","—",""],["Ensemble","peso_Theta",0.2596,"—","—","—","—",""],["Ensemble","peso_LSTM_Forecast",0.251,"—","—","—","—",""]]
