ncia_mm_3",0.062,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1484,"—","—","—","—",""],["GradientBoosting","importância_mes",0.3212,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.2267,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0292,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.141·ARIMA + 0.118·SARIMAX-12 + 0.140·SARIMAX-6 + 0.129·Holt-Winters + 0.130·Prophet/UC + 0.128·Theta + 0.071·GradientBoosting + 0.143·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1406,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1183,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1402,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1287,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.13,"—","—","—","—",""],["Ensemble","peso_Theta",0.1277,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.0712,"—","—","—","—",""],["Ensemble","peso_LSTM_Forecast",0.1433,"—","—","—","—",""]]
