as (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",569.5353,"—","—","—","—",""],["Prophet/UC","BIC",592.4138,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",1.4415,0.3268,0,0.801,2.082,"Sim"],["Prophet/UC","sigma2.level",1.1242,0.273,0,0.5892,1.6592,"Sim"],["Prophet/UC","sigma2.trend",0,0.0007,1,-0.0015,0.0015,"Não"],["Prophet/UC","sigma2.seasonal",0,0.0276,1,-0.0542,0.0542,"Não"],["Prophet/UC","beta.x1",-0.0027,0.003,0.3772,-0.0087,0.0033,"Não"],["Prophet/UC","beta.x2",0.0582,0,0,0.0582,0.0582,"Sim"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.0364,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.5385,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.2777,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0843,"—","—",