ação","UnobservedComponents(LLT + seasonal=12 + exog)","","","","",""],["Prophet/UC","AIC",537.34,"","","","",""],["Prophet/UC","BIC",559.9,"","","","",""],["Prophet/UC","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",537.3416,"—","—","—","—",""],["Prophet/UC","BIC",559.9039,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",1.2443,0.2886,0,0.6786,1.81,"Sim"],["Prophet/UC","sigma2.level",1.1077,0.2515,0,0.6148,1.6007,"Sim"],["Prophet/UC","sigma2.trend",0,0.0007,1,-0.0013,0.0013,"Não"],["Prophet/UC","sigma2.seasonal",0,0.0256,1,-0.0501,0.0501,"Não"],["Prophet/UC","beta.x1",-0.0025,0.0028,0.381,-0.0079,0.003,"Não"],["Prophet/UC","beta.x2",0.0877,0,0,0.0877,0.0877,"Sim"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.0377,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.5463,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoos