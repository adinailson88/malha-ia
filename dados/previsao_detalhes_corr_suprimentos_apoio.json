osting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.0724,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0482,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0596,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0848,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.0815,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.0859,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1204,"—","—","—","—",""],["GradientBoosting","importância_mes",0.1559,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.2661,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0252,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.119·ARIMA + 0.115·SARIMAX-12 + 0.127·SARIMAX-6 + 0.121·Holt-Winters + 0.107·Prophet/UC + 0.115·Theta + 0.172·GradientBoosting + 0.123·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1195,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1155,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1267,"—","—