ivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.0692,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0623,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0594,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1089,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.0904,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.0944,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1327,"—","—","—","—",""],["GradientBoosting","importância_mes",0.1727,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.1885,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0216,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.136·ARIMA + 0.133·SARIMAX-12 + 0.134·SARIMAX-6 + 0.130·Holt-Winters + 0.102·Prophet/UC + 0.129·Theta + 0.076·GradientBoosting + 0.160·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1363,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1327,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1345,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1298,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.1018,"—","—","—","—",""