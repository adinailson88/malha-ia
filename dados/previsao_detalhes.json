vel + slope), γ(t) é sazonalidade trigonométrica de período 12, β·X(t) são regressores exógenos (precipitação, letivo) e ε(t) ~ N(0,σ²). Estimação por filtro de Kalman e máxima verossimilhança.","","","","",""],["Prophet/UC","Configuração","UnobservedComponents(LLT + seasonal=12 + exog)","","","","",""],["Prophet/UC","AIC",1301.19,"","","","",""],["Prophet/UC","BIC",1323.88,"","","","",""],["Prophet/UC","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",1301.1919,"—","—","—","—",""],["Prophet/UC","BIC",1323.8822,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",71.0904,95.433,0.4563,-115.9583,258.139,"Não"],["Prophet/UC","sigma2.level",391.6049,97.0175,0.0001,201.4506,581.7593,"Sim"],["Prophet/UC","sigma2.trend",0,0.6529,1,-1.2797,1.2797,"Não"],["Prophet/UC","sigma2.seasonal",200.8608,53.4848,0.0002,96.0306,305.691,"Sim"],["Prophet/UC","beta.x1",-0.0499,0.0762,0.5128,-0.1992,0.0995,"Não"],["Prophet/UC","beta.x2",3.3401,104253.1172,1,-204332.7696,204339.4497,"Não"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.8228,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.5246,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1449,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0794,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0669,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1175,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.2124,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.114,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1769,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0527,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0304,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0048,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.091·ARIMA + 0.119·SARIMAX-12 + 0.086·SARIMAX-6 + 0.122·Holt-Winters + 0.079·Prophet/UC + 0.126·Theta + 0.256·GradientBoosting + 0.120·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","U