 Prophet/cmdstanpy. y(t) = μ(t) + γ(t) + β·X(t) + ε(t), onde μ(t) é tendência local linear (level + slope), γ(t) é sazonalidade trigonométrica de período 12, β·X(t) são regressores exógenos (precipitação, letivo) e ε(t) ~ N(0,σ²). Estimação por filtro de Kalman e máxima verossimilhança.","","","","",""],["Prophet/UC","Configuração","UnobservedComponents(LLT + seasonal=12 + exog)","","","","",""],["Prophet/UC","AIC",1332.84,"","","","",""],["Prophet/UC","BIC",1355.72,"","","","",""],["Prophet/UC","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",1332.8429,"—","—","—","—",""],["Prophet/UC","BIC",1355.7214,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",53.4863,90.2242,0.5533,-123.3532,230.3258,"Não"],["Prophet/UC","sigma2.level",387.0693,86.7499,0,217.0395,557.099,"Sim"],["Prophet/UC","sigma2.trend",0,0.611,1,-1.1976,1.1976,"Não"],["Prophet/UC","sigma2.seasonal",218.9747,56.0723,0.0001,109.073,328.8763,"Sim"],["Prophet/UC","beta.x1",0.0355,0.0851,0.6771,-0.1314,0.2023,"Não"],["Prophet/UC","beta.x2",2.0049,108778.0156,1,-213202.9057,213206.9155,"Não"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.8151,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.5274,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1639,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0875,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.068,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1122,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.2039,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1164,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.197,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0385,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0083,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0043,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.158·ARIMA + 0.154·SARIMAX-12 + 0.140·SARIMAX-6 + 0.164·Holt-Winters + 0.138·Prophet/UC + 0.158·Theta + 0.089·GradientBoosting. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1578,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1536,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1399,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1644,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.1379,"—","—","—","—",""],["Ensemble","peso_Theta",0.1577,"—","—","—","—",""],["Ensemble","peso_Gradient