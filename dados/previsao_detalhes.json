ivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1077,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1374,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.105,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1272,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.1309,"—","—","—","—",""],["Ensemble","peso_Theta",0.129,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.1647,"—","—","—","—",""],["Ensemble","peso_LSTM_Forecast",0.0982,"—","—","—","—",""]]
