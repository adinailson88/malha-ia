genas X = [Precipitação_mm, Período_Letivo]: combinação de componentes AR/MA não-sazonais e sazonais com diferenciação ordinária (1) e sazonal (1), regredida sobre X.","","","","",""],["SARIMAX-6","Configuração","SARIMAX(0,1,2)(0,1,1)[6]+exog","","","","",""],["SARIMAX-6","AIC",2564.28,"","","","",""],["SARIMAX-6","BIC",2585.2,"","","","",""],["SARIMAX-6","Usa exógenas (chuva, letivo)","Sim","","","","",""],["SARIMAX-6","x1",-36.4625,265.9469,0.8909,-557.7184,484.7935,"Não"],["SARIMAX-6","x2",10099.0797,38057.4052,0.7907,-64493.4344,84691.5939,"Não"],["SARIMAX-6","const",0,0.0073,1,-0.0144,0.0144,"Não"],["SARIMAX-6","x3",0,0,1,0,0,"Não"],["SARIMAX-6","ma.L1",-0.9414,0.2572,0.0003,-1.4456,-0.4373,"Sim"],["SARIMAX-6","ma.L2",0.0361,0.2196,0.8693,-0.3943,0.4666,"Não"],["SARIMAX-6","ma.S.L6",-0.9233,0.0958,0,-1.1111,-0.7354,"Sim"],["SARIMAX-6","sigma2",8786281769.0149,0.306,0,8786281768.4151,8786281769.6147,"Sim"],["","","","","","","",""],["Holt-Winters","EQUAÇÃO","Holt-Winters Aditivo: ℓ(t) = α·y(t) + (1-α)·[ℓ(t-1) + b(t-1)]; b(t) = β·[ℓ(t)-ℓ(t-1)] + (1-β)·b(t-1); s(t) = γ·[y(t)-ℓ(t)] + (1-γ)·s(t-12). Forecast: ŷ(t+h) = ℓ(t) + h·b(t) + s(t-12+h).","","","","",""],["Holt-Winters","Configuração","HW(α=0.111,β=0.025,γ=0.099)","","","","",""],["Holt-Winters","AIC",2613.65,"","","","",""],["Holt-Winters","BIC",2657.85,"","","","",""],["Holt-Winters","Usa exógenas (chuva, letivo)","Não","","","","",""],["Holt-Winters","α (suavização nível)",0.1111,"—","—","—","—",""],["Holt-Winters","β (suavização tendência)",0.0247,"—","—","—","—",""],["Holt-Winters","γ (suavização sazonal)",0.0988,"—","—","—","—",""],["Holt-Winters","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["Prophet/UC","EQUAÇÃO","UnobservedComponents (Harvey, 1989) — fallback ativado por indisponibilidade do Prophet/cmdstanpy. y(t) = μ(t) + γ(t) + β·X(t) + ε(t), onde μ(t) é tendência local linear (level + slope), γ(t) é sazonalidade trigonométrica de período 12, β·X(t) são regressores exógenos (