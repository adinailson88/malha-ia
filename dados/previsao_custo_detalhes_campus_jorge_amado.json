 {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1455,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.1233,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.1529,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1116,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1182,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1364,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1147,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0602,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0222,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0149,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.143·ARIMA + 0.128·SARIMAX-12 + 0.132·SARIMAX-6 + 0.126·Holt-Winters + 0.067·Prophet/UC + 0.134·Theta + 0.270·GradientBoosting. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1427,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1278,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.132,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1264,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.0672,"—","—","—","—",""],["Ensemble","peso_Theta",0.1335,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.2703,"—","—","—","—",