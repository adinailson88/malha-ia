a, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1434,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.1169,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.1091,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1016,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1013,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.109,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.2266,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0656,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0147,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0117,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.105·ARIMA + 0.138·SARIMAX-12 + 0.121·SARIMAX-6 + 0.127·Holt-Winters + 0.110·Prophet/UC + 0.136·Theta + 0.139·GradientBoosting + 0.125·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1053,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1376,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1206,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1269,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.1098,"—","—","—","