a, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1513,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.1219,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.11,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1042,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.0991,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1003,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.2298,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0651,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0072,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0112,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.143·ARIMA + 0.163·SARIMAX-12 + 0.145·SARIMAX-6 + 0.151·Holt-Winters + 0.153·Prophet/UC + 0.156·Theta + 0.090·GradientBoosting. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1431,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1628,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1451,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1506,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.1532,"—","—","—","—",""],["Ensemble","peso_Theta",0.1557,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.0895,"—","—","—","—",""]]
