a, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1524,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.1235,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.1096,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1045,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.0949,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1003,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.2272,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0668,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0097,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.011,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.127·ARIMA + 0.144·SARIMAX-12 + 0.128·SARIMAX-6 + 0.133·Holt-Winters + 0.136·Prophet/UC + 0.138·Theta + 0.081·GradientBoosting + 0.113·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1266,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1443,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1276,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1333,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.1364,"—","—","—","