-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.0024,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0019,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0022,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0005,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.0044,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.0011,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.0031,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0518,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.9163,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0164,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.137·ARIMA + 0.137·SARIMAX-12 + 0.139·SARIMAX-6 + 0.136·Holt-Winters + 0.132·Prophet/UC + 0.138·Theta + 0.040·GradientBoosting + 0.141·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1368,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1374,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1392,"—","—","—","—",""],["Ensemble","