 exog)","","","","",""],["Prophet/UC","AIC",1210.78,"","","","",""],["Prophet/UC","BIC",1227.8,"","","","",""],["Prophet/UC","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",1210.7849,"—","—","—","—",""],["Prophet/UC","BIC",1227.802,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",11589403.3178,3590869.4971,0.0012,4551299.1035,18627507.532,"Sim"],["Prophet/UC","sigma2.level",241.6871,850999.8043,0.9998,-1667717.9293,1668201.3036,"Não"],["Prophet/UC","sigma2.trend",204.668,2111.8364,0.9228,-3934.5315,4343.8674,"Não"],["Prophet/UC","sigma2.seasonal",40.2051,498240.9975,0.9999,-976512.1499,976592.5602,"Não"],["Prophet/UC","beta.x1",40.7205,7.8127,0,25.4075,56.0335,"Sim"],["Prophet/UC","beta.x2",-1073.2133,2608.3592,0.6807,-6185.5973,4039.1708,"Não"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",-5.1933,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.2692,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.0701,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0631,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0486,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0062,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1182,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.0517,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.2278,"—","—","—","—",""],["GradientBoosting","importância_mes",0.2248,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.1401,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0493,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.142·ARIMA + 0.052·SARIMAX-12 + 0.030·SARIMAX-6 + 0.042·Holt-Winters + 0.001·Prophet/UC + 0.383·Theta + 0.173·GradientBoosting + 0.177·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1418,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.0522,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.0302,"—","—","—","—",""],[