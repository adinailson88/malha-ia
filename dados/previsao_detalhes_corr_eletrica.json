va, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1048,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0846,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0624,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.093,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.184,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1874,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1565,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0924,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0229,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0119,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.089·ARIMA + 0.125·SARIMAX-12 + 0.110·SARIMAX-6 + 0.120·Holt-Winters + 0.122·Prophet/UC + 0.103·Theta + 0.151·GradientBoosting + 0.180·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.0886,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1253,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1102,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1197,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.1223,"—","—","—","