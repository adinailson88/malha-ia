ógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.0998,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0818,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0605,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.093,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.184,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1856,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1576,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0989,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0276,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0112,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.088·ARIMA + 0.108·SARIMAX-12 + 0.101·SARIMAX-6 + 0.120·Holt-Winters + 0.119·Prophet/UC + 0.103·Theta + 0.163·GradientBoosting + 0.199·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.0884,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.108,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1008,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1195,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.1185,"—"