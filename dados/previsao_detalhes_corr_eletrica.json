ança.","","","","",""],["Prophet/UC","Configuração","UnobservedComponents(LLT + seasonal=12 + exog)","","","","",""],["Prophet/UC","AIC",837.88,"","","","",""],["Prophet/UC","BIC",860.38,"","","","",""],["Prophet/UC","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",837.8791,"—","—","—","—",""],["Prophet/UC","BIC",860.3765,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",21.8849,4.5302,0,13.0057,30.764,"Sim"],["Prophet/UC","sigma2.level",5.9341,2.5198,0.0185,0.9953,10.873,"Sim"],["Prophet/UC","sigma2.trend",0.0002,0.0073,0.9833,-0.0141,0.0144,"Não"],["Prophet/UC","sigma2.seasonal",0.0179,0.3072,0.9534,-0.5841,0.62,"Não"],["Prophet/UC","beta.x1",0.0122,0.0191,0.521,-0.0251,0.0496,"Não"],["Prophet/UC","beta.x2",-0.451,167182.0928,1,-327677.3529,327676.4509,"Não"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.0362,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.3853,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1046,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0878,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0616,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0895,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1846,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1878,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1572,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0962,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0197,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0111,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.087·ARIMA + 0.095·SARIMAX-12 + 0.094·SARIMAX-6 + 0.116·Holt-Winters + 0.107·Prophet/UC + 0.101·Theta + 0.190·GradientBoosting + 0.209·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.087,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.0949,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.0945,"—","—","