a, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.109,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0874,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0618,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0942,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1869,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1885,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1456,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0924,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0233,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0108,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.128·ARIMA + 0.123·SARIMAX-12 + 0.134·SARIMAX-6 + 0.127·Holt-Winters + 0.121·Prophet/UC + 0.128·Theta + 0.106·GradientBoosting + 0.134·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1276,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.123,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1344,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1266,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.1209,"—","—","—","—