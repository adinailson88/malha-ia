, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1103,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0878,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0615,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0936,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1863,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1877,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1472,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0928,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.022,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0108,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.127·ARIMA + 0.122·SARIMAX-12 + 0.133·SARIMAX-6 + 0.126·Holt-Winters + 0.120·Prophet/UC + 0.127·Theta + 0.106·GradientBoosting + 0.140·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1266,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1222,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1334,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1256,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.1199,"—","—","—","—