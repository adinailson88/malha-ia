ão por filtro de Kalman e máxima verossimilhança.","","","","",""],["Prophet/UC","Configuração","UnobservedComponents(LLT + seasonal=12 + exog)","","","","",""],["Prophet/UC","AIC",717.92,"","","","",""],["Prophet/UC","BIC",738.52,"","","","",""],["Prophet/UC","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",717.9196,"—","—","—","—",""],["Prophet/UC","BIC",738.5173,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",43.2515,10.2968,0,23.0698,63.4332,"Sim"],["Prophet/UC","sigma2.level",1.287,2.2983,0.5755,-3.2177,5.7916,"Não"],["Prophet/UC","sigma2.trend",0,0.0048,1,-0.0094,0.0094,"Não"],["Prophet/UC","sigma2.seasonal",3.1517,2.4159,0.192,-1.5835,7.887,"Não"],["Prophet/UC","beta.x1",-0.0044,0.0108,0.6842,-0.0256,0.0168,"Não"],["Prophet/UC","beta.x2",1.3427,0,0,1.3427,1.3428,"Sim"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.0536,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.1076,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1058,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.065,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0799,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0812,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.0454,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.0552,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.095,"—","—","—","—",""],["GradientBoosting","importância_mes",0.1779,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.2634,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0312,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.077·ARIMA + 0.177·SARIMAX-12 + 0.163·SARIMAX-6 + 0.178·Holt-Winters + 0.120·Prophet/UC + 0.089·Theta + 0.124·GradientBoosting + 0.073·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.0766,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.177,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0