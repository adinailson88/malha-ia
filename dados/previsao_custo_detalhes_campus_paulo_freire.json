genas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1363,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1406,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1304,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1203,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.0823,"—","—","—","—",""],["Ensemble","peso_Theta",0.1448,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.0961,"—","—","—","—",""],["Ensemble","peso_LSTM_Forecast",0.1493,"—","—","—","—",""]]
