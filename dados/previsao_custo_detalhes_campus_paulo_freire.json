(0,σ²). Estimação por filtro de Kalman e máxima verossimilhança.","","","","",""],["Prophet/UC","Configuração","UnobservedComponents(LLT + seasonal=12 + exog)","","","","",""],["Prophet/UC","AIC",2575.3,"","","","",""],["Prophet/UC","BIC",2596.38,"","","","",""],["Prophet/UC","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",2575.302,"—","—","—","—",""],["Prophet/UC","BIC",2596.3799,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",1716369784.9886,753046074.8791,0.0227,240399478.2256,3192340091.7517,"Sim"],["Prophet/UC","sigma2.level",3529332.2864,25839352.5717,0.8914,-47115798.7541,54174463.3268,"Não"],["Prophet/UC","sigma2.trend",8.1839,32951.3484,0.9998,-64576.459,64592.8268,"Não"],["Prophet/UC","sigma2.seasonal",1568960654.9432,831138738.0205,0.0591,-60071271.577,3197992581.4635,"Não"],["Prophet/UC","beta.x1",-191.1136,265.909,0.4723,-712.2952,330.068,"Não"],["Prophet/UC","beta.x2",-359.0894,38276.9442,0.9925,-75381.9,74663.7212,"Não"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",188.4915,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.0643,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1349,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.1264,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.1584,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1361,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1112,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1311,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1379,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0366,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0199,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0076,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.117·ARIMA + 0.139·SARIMAX-12 + 0.113·SARIMAX-6 + 0.103·Holt-Winters + 0.080·Prophet/UC + 0.128·Theta + 0.185·GradientBoosting + 0.135·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, l