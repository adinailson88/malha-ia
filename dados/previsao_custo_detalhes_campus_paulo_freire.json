 N(0,σ²). Estimação por filtro de Kalman e máxima verossimilhança.","","","","",""],["Prophet/UC","Configuração","UnobservedComponents(LLT + seasonal=12 + exog)","","","","",""],["Prophet/UC","AIC",2618.7,"","","","",""],["Prophet/UC","BIC",2639.93,"","","","",""],["Prophet/UC","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",2618.7009,"—","—","—","—",""],["Prophet/UC","BIC",2639.9326,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",1633101181.6998,730091451.0633,0.0253,202121937.6157,3064080425.784,"Sim"],["Prophet/UC","sigma2.level",2940675.068,20847675.0837,0.8878,-37920768.096,43802118.232,"Não"],["Prophet/UC","sigma2.trend",1486.1652,25026.6453,0.9526,-47566.0597,50538.3901,"Não"],["Prophet/UC","sigma2.seasonal",1496230530.3749,783175732.2909,0.0561,-38793904.9153,3031254965.6652,"Não"],["Prophet/UC","beta.x1",-241.8522,239.8897,0.3134,-712.0359,228.3316,"Não"],["Prophet/UC","beta.x2",1907.4373,53010.1237,0.9713,-101992.4051,105807.2798,"Não"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",185.9203,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.0643,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1255,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.115,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.1605,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1396,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1167,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1241,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1188,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0409,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0527,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0061,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.132·ARIMA + 0.135·SARIMAX-12 + 0.125·SARIMAX-6 + 0.118·Holt-Winters + 0.078·Prophet/UC + 0.144·Theta + 0.267·GradientBoosting. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1322,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1351,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1248,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1183,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.0784,"—","—","—","—",""],["Ensemble","peso_Theta",0.1439,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.2674,"—","—","—","—",""]]
