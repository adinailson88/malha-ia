(t) ~ N(0,σ²). Estimação por filtro de Kalman e máxima verossimilhança.","","","","",""],["Prophet/UC","Configuração","UnobservedComponents(LLT + seasonal=12 + exog)","","","","",""],["Prophet/UC","AIC",2530.79,"","","","",""],["Prophet/UC","BIC",2551.79,"","","","",""],["Prophet/UC","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",2530.7855,"—","—","—","—",""],["Prophet/UC","BIC",2551.7853,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",1053429316.2829,384064606.3709,0.0061,300662687.7959,1806195944.7699,"Sim"],["Prophet/UC","sigma2.level",17310227.8606,56597797.1872,0.7597,-93621454.6264,128241910.3476,"Não"],["Prophet/UC","sigma2.trend",192.5575,122100.221,0.9987,-239123.8757,239508.9907,"Não"],["Prophet/UC","sigma2.seasonal",526694727.7182,207842725.407,0.0113,119322985.9204,934066469.5159,"Sim"],["Prophet/UC","beta.x1",140.7799,148.8549,0.3443,-150.9758,432.5356,"Não"],["Prophet/UC","beta.x2",251.5108,23743.3354,0.9915,-46285.4265,46788.4482,"Não"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",194.3996,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.0639,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1368,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.1039,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.156,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1355,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1279,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1136,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1404,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0422,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0378,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0059,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.120·ARIMA + 0.144·SARIMAX-12 + 0.124·SARIMAX-6 + 0.105·Holt-Winters + 0.077·Prophet/UC + 0.134·Theta + 0.152·GradientBoosting + 0.143·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1198,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1443,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1239,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.105,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.0769,"—","—","—","—",""],["Ensemble","peso_Theta",0.1341,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.1525,"—","—","—","—",""],["Ensemble","peso_LSTM_Forecast",0.1434,"—","—","—","—",""]]
