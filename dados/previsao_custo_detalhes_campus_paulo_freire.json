imação por filtro de Kalman e máxima verossimilhança.","","","","",""],["Prophet/UC","Configuração","UnobservedComponents(LLT + seasonal=12 + exog)","","","","",""],["Prophet/UC","AIC",2525.04,"","","","",""],["Prophet/UC","BIC",2545.96,"","","","",""],["Prophet/UC","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",2525.0395,"—","—","—","—",""],["Prophet/UC","BIC",2545.9604,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",1722912107.3274,809587815.3413,0.0333,136119989.2585,3309704225.3964,"Sim"],["Prophet/UC","sigma2.level",2994987.6312,25618072.2927,0.9069,-47216434.0625,53206409.325,"Não"],["Prophet/UC","sigma2.trend",5.4692,29590.8653,0.9999,-57992.6268,58003.5652,"Não"],["Prophet/UC","sigma2.seasonal",1571155541.5097,861956490.0715,0.0683,-118279179.0304,3260590262.0498,"Não"],["Prophet/UC","beta.x1",-138.7014,271.4582,0.6094,-670.7594,393.3566,"Não"],["Prophet/UC","beta.x2",2033.5139,43239.4111,0.9625,-82715.7318,86782.7596,"Não"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",201.0167,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.0643,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1349,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.1312,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.1531,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1463,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1093,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1163,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1143,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0364,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0518,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0065,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.138·ARIMA + 0.143·SARIMAX-12 + 0.130·SARIMAX-6 + 0.122·Holt-Winters + 0.080·Prophet/UC + 0.147·Theta + 0.100·GradientBoosting + 0.139·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1383,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1435,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1304,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1221,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.0796,"—","—","—","—",""],["Ensemble","peso_Theta",0.1469,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.1002,"—","—","—","—",""],["Ensemble","peso_LSTM_Forecast",0.139,"—","—","—","—",""]]
