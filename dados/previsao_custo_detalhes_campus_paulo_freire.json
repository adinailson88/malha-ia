tal: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1356,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.1096,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.1481,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1453,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1122,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1266,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1325,"—","—","—","—",""],["GradientBoosting","importância_mes",0.04,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.043,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0071,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.110·ARIMA + 0.142·SARIMAX-12 + 0.127·SARIMAX-6 + 0.111·Holt-Winters + 0.077·Prophet/UC + 0.143·Theta + 0.136·GradientBoosting + 0.154·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim",