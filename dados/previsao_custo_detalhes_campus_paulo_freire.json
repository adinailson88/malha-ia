_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1287,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.1035,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.1581,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1504,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1206,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1274,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1242,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0368,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.042,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0082,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.134·ARIMA + 0.135·SARIMAX-12 + 0.125·SARIMAX-6 + 0.120·Holt-Winters + 0.076·Prophet/UC + 0.146·Theta + 0.265·GradientBoosting. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1337,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.135,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1253,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1197,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.0762,"—","—","—","—",""],["Ensemble","peso_Theta",0.1455,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.2646,"—","—","—","—",""]]
