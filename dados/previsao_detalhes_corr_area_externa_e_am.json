ular",0.8684,0.1508,0,0.5727,1.164,"Sim"],["Prophet/UC","sigma2.level",0.0133,0.0346,0.7003,-0.0545,0.0812,"Não"],["Prophet/UC","sigma2.trend",0,0.0001,0.7451,-0.0001,0.0002,"Não"],["Prophet/UC","sigma2.seasonal",0.0752,0.0506,0.1369,-0.0239,0.1744,"Não"],["Prophet/UC","beta.x1",-0.0019,0.0023,0.4048,-0.0063,0.0025,"Não"],["Prophet/UC","beta.x2",-0.0332,0,0,-0.0332,-0.0332,"Sim"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.0136,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.1876,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.0619,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0621,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0505,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0572,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.