izados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1043,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.1043,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0751,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0651,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.0696,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.0753,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.3035,"—","—","—","—",""],["GradientBoosting","importância_mes",0.098,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0965,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0082,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.121·ARIMA + 0.146·SARIMAX-12 + 0.138·SARIMAX-6 + 0.147·Holt-Winters + 0.119·Prophet/UC + 0.146·Theta + 0.056·GradientBoosting + 0.127·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ense