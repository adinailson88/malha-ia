.","","","","",""],["Prophet/UC","Configuração","UnobservedComponents(LLT + seasonal=12 + exog)","","","","",""],["Prophet/UC","AIC",392.48,"","","","",""],["Prophet/UC","BIC",413.55,"","","","",""],["Prophet/UC","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",392.476,"—","—","—","—",""],["Prophet/UC","BIC",413.5538,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",0.8288,0.2806,0.0031,0.2789,1.3787,"Sim"],["Prophet/UC","sigma2.level",0.0241,0.0564,0.6692,-0.0865,0.1347,"Não"],["Prophet/UC","sigma2.trend",0.0003,0.0004,0.4377,-0.0004,0.001,"Não"],["Prophet/UC","sigma2.seasonal",0.2758,0.1329,0.038,0.0152,0.5363,"Sim"],["Prophet/UC","beta.x1",0.0006,0.0022,0.7808,-0.0038,0.005,"Não"],["Prophet/UC","beta.x2",-0.1268,0,0,-0.1268,-0.1268,"Sim"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.0234,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.1659,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração"