 treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.0882,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0809,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.083,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1257,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1119,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1444,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1966,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0901,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0591,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0202,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.125·ARIMA + 0.133·SARIMAX-12 + 0.108·SARIMAX-6 + 0.138·Holt-Winters + 0.070·Prophet/UC + 0.151·Theta + 0.118·GradientBoosting + 0.157·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1247,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1334,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1077,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1378,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.0699,"—","—","—","—",""],["Ensemble","peso_Theta",0.1514,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.1179,"—","—","—","—",""],["Ensemble","peso_LSTM_Forecast",0.1572,"—","—","—","—",""]]
