 Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1524,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.1084,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.1448,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1671,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1307,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.0735,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1129,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0643,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0404,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0055,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.247·ARIMA + 0.123·SARIMAX-12 + 0.166·SARIMAX-6 + 0.093·Holt-Winters + 0.137·Prophet/UC + 0.133·Theta + 0.102·GradientBoosting. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.2469,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.123,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1658,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.0926,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.1374,"—","—","—","—",""],["Ensemble","peso_Theta",0.1326,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.1017,"—","—","—","—",""]]
