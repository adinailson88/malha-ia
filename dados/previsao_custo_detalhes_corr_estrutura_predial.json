 lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1519,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.1007,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.1435,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1629,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1267,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.0707,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1226,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0644,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0505,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.006,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.142·ARIMA + 0.124·SARIMAX-12 + 0.160·SARIMAX-6 + 0.138·Holt-Winters + 0.118·Prophet/UC + 0.137·Theta + 0.061·GradientBoosting + 0.119·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA