, área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1494,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.132,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.1069,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1159,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1814,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.0725,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1096,"—","—","—","—",""],["GradientBoosting","importância_mes",0.1051,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0219,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0054,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.113·ARIMA + 0.172·SARIMAX-12 + 0.178·SARIMAX-6 + 0.113·Holt-Winters + 0.169·Prophet/UC + 0.109·Theta + 0.146·GradientBoosting. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.113,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1724,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1777,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1125,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.169,"—","—","—","—",""],["Ensemble","peso_Theta",0.1091,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.1462,"—","—","—","—",""]]
