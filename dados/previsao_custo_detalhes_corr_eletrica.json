cast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1142,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.1201,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.1201,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1619,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1603,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.0855,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.162,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0518,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0055,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0187,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.123·ARIMA + 0.115·SARIMAX-12 + 0.117·SARIMAX-6 + 0.107·Holt-Winters + 0.100·Prophet/UC + 0.123·Theta + 0.190·GradientBoosting + 0.124·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1234,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1148,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1174,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1075,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.1003,"—","—","—","—",""],["Ensemble","peso_Theta",0.1231,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.19,"—","—","—","—",""],["Ensemble","peso_LSTM_Forecast",0.1236,"—","—","—","—",""]]
