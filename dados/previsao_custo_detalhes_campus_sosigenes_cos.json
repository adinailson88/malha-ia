19·SARIMAX-6 + 0.120·Holt-Winters + 0.090·Prophet/UC + 0.154·Theta + 0.077·GradientBoosting + 0.139·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1764,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1244,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1185,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1204,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.0905,"—","—","—","—",""],["Ensemble","peso_Theta",0.1539,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.0766,"—","—","—","—",""],["Ensemble","peso_LSTM_Forecast",0.1394,"—","—","—","—",""]]
