 0.109·SARIMAX-6 + 0.113·Holt-Winters + 0.087·Prophet/UC + 0.150·Theta + 0.120·GradientBoosting + 0.153·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.144,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.124,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.109,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1132,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.0874,"—","—","—","—",""],["Ensemble","peso_Theta",0.1498,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.1199,"—","—","—","—",""],["Ensemble","peso_LSTM_Forecast",0.1526,"—","—","—","—",""]]
