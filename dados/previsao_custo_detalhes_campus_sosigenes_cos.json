 0.131·SARIMAX-6 + 0.114·Holt-Winters + 0.085·Prophet/UC + 0.146·Theta + 0.072·GradientBoosting + 0.167·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.167,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1194,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.131,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.114,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.0845,"—","—","—","—",""],["Ensemble","peso_Theta",0.1457,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.0717,"—","—","—","—",""],["Ensemble","peso_LSTM_Forecast",0.1667,"—","—","—","—",""]]
