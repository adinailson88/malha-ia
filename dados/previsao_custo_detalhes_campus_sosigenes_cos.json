odo sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1124,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.119,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.1594,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1567,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1341,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1298,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1084,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0294,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0412,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0097,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.157·ARIMA + 0.165·SARIMAX-12 + 0.103·SARIMAX-6 + 0.132·Holt-Winters + 0.082·Prophet/UC + 0.191·Theta + 0.169·GradientBoosting. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1574,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1654,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1031,"—","—","—","—",""],["Ensemble","peso_Holt-Wi