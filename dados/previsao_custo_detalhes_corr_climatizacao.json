 exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1183,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1117,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.163,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1176,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.0399,"—","—","—","—",""],["Ensemble","peso_Theta",0.1435,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.1491,"—","—","—","—",""],["Ensemble","peso_LSTM_Forecast",0.1569,"—","—","—","—",""]]
