 depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1273,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0901,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.1353,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0674,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1096,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1184,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1723,"—","—","—","—",""],["GradientBoosting","importância_mes",0.1155,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0513,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0129,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.098·ARIMA + 0.154·SARIMAX-12 + 0.123·SARIMAX-6 + 0.124·Holt-Winters + 0.179·Prophet/UC + 0.121·Theta + 0.084·GradientBoosting + 0.117·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.0981,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1545,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1229,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0