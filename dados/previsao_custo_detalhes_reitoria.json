uração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1536,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1273,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1112,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1543,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.0453,"—","—","—","—",""],["Ensemble","peso_Theta",0.1809,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.0718,"—","—","—","—",""],["Ensemble","peso_LSTM_Forecast",0.1554,"—","—","—","—",""]]
