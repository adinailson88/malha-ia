ima verossimilhança.","","","","",""],["Prophet/UC","Configuração","UnobservedComponents(LLT + seasonal=12 + exog)","","","","",""],["Prophet/UC","AIC",869.11,"","","","",""],["Prophet/UC","BIC",891.67,"","","","",""],["Prophet/UC","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",869.1127,"—","—","—","—",""],["Prophet/UC","BIC",891.675,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",25.6545,3.8156,0,18.1759,33.1331,"Sim"],["Prophet/UC","sigma2.level",6.6402,2.3713,0.0051,1.9924,11.288,"Sim"],["Prophet/UC","sigma2.trend",0,0.0115,1,-0.0226,0.0226,"Não"],["Prophet/UC","sigma2.seasonal",0.4484,0.6224,0.4713,-0.7715,1.6682,"Não"],["Prophet/UC","beta.x1",-0.002,0.0148,0.8916,-0.031,0.027,"Não"],["Prophet/UC","beta.x2",0.2508,163038.7112,1,-319555.6232,319556.1249,"Não"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.0833,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.4406,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.0903,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0586,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.048,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0608,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1694,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.2676,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1455,"—","—","—","—",""],["GradientBoosting","importância_mes",0.1081,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0439,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0077,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.097·ARIMA + 0.114·SARIMAX-12 + 0.146·SARIMAX-6 + 0.146·Holt-Winters + 0.144·Prophet/UC + 0.124·Theta + 0.097·GradientBoosting + 0.131·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.0974,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1142,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1459,"—"