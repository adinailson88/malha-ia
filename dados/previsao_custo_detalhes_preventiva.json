ção, letivo) e ε(t) ~ N(0,σ²). Estimação por filtro de Kalman e máxima verossimilhança.","","","","",""],["Prophet/UC","Configuração","UnobservedComponents(LLT + seasonal=12 + exog)","","","","",""],["Prophet/UC","AIC",2606.87,"","","","",""],["Prophet/UC","BIC",2627.39,"","","","",""],["Prophet/UC","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",2606.8705,"—","—","—","—",""],["Prophet/UC","BIC",2627.3852,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",8995919643.879,8321941182.2962,0.2797,-7315085073.4214,25306924361.1795,"Não"],["Prophet/UC","sigma2.level",20916541.0729,11676917590.7237,0.9986,-22865841936.7456,22907675018.8915,"Não"],["Prophet/UC","sigma2.trend",412311894.8454,1193121973.2584,0.7297,-1926207172.741,2750830962.4318,"Não"],["Prophet/UC","sigma2.seasonal",8995919643.879,4134395488.0486,0.0296,892504487.3039,17099334800.4542,"Sim"],["Prophet/UC","beta.x1",-89.156,1286.7425,0.9448,-2611.1713,2432.8592,"Não"],["Prophet/UC","beta.x2",6114.8024,758421.9136,0.9936,-1480392.1482,1492621.7531,"Não"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",381.6958,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.0521,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.0977,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.1018,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.1387,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1114,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1016,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1545,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1888,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0616,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0415,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0025,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.125·ARIMA + 0.147·SARIMAX-12 + 0.150·SARIMAX-6 + 0.127·Holt-Winters + 0.114·Prophet/UC + 0.138·Theta + 0.199·GradientBoosting. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1245,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1469,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1504,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1273,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.1137,"—","—","—","—",""],["Ensemble","peso_Theta",0.1381,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.199,"—","—","—","—",""]