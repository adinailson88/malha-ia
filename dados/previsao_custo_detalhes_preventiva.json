ormalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1077,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.128,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1348,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1356,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.0584,"—","—","—","—",""],["Ensemble","peso_Theta",0.1486,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.1191,"—","—","—","—",""],["Ensemble","peso_LSTM_Forecast",0.1677,"—","—","—","—",""]]
