ados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1307,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0979,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.1061,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1207,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1533,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.0795,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1159,"—","—","—","—",""],["GradientBoosting","importância_mes",0.1436,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0399,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0125,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.128·ARIMA + 0.170·SARIMAX-12 + 0.152·SARIMAX-6 + 0.146·Holt-Winters + 0.173·Prophet/UC + 0.140·Theta + 0.092·GradientBoosting. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1278,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1705,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1516,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1461,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.1725,"—","—","—","—",""],["Ensemble","peso_Theta",0.14,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.0915,"—","—","—","—",""]]
