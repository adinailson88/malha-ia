het/UC","AIC",1114.59,"","","","",""],["Prophet/UC","BIC",1136.12,"","","","",""],["Prophet/UC","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",1114.5923,"—","—","—","—",""],["Prophet/UC","BIC",1136.1231,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",219.6279,97.5339,0.0243,28.4615,410.7943,"Sim"],["Prophet/UC","sigma2.level",125.42,42.2313,0.003,42.6467,208.1933,"Sim"],["Prophet/UC","sigma2.trend",0,0.3173,1,-0.622,0.622,"Não"],["Prophet/UC","sigma2.seasonal",236.527,49.0631,0,140.3633,332.6908,"Sim"],["Prophet/UC","beta.x1",0.0102,0.0799,0.8988,-0.1464,0.1667,"Não"],["Prophet/UC","beta.x2",6.8352,121121.8432,1,-237391.9775,237405.6478,"Não"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.0509,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.3374,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (