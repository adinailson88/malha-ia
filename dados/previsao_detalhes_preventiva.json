=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1357,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0915,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.1098,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1209,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1393,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.0822,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1208,"—","—","—","—",""],["GradientBoosting","importância_mes",0.1475,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0434,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.009,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.119·ARIMA + 0.160·SARIMAX-12 + 0.129·SARIMAX-6 + 0.121·Holt-Winters + 0.080·Prophet/UC + 0.120·Theta + 0.139·GradientBoosting + 0.131·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1191,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1601,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1292,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1214,"—","—"