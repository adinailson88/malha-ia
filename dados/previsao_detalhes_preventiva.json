lhança.","","","","",""],["Prophet/UC","Configuração","UnobservedComponents(LLT + seasonal=12 + exog)","","","","",""],["Prophet/UC","AIC",1114.44,"","","","",""],["Prophet/UC","BIC",1135.97,"","","","",""],["Prophet/UC","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",1114.4354,"—","—","—","—",""],["Prophet/UC","BIC",1135.9661,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",220.6598,97.5013,0.0236,29.5573,411.7624,"Sim"],["Prophet/UC","sigma2.level",126.6798,42.536,0.0029,43.3092,210.0503,"Sim"],["Prophet/UC","sigma2.trend",0,0.3346,1,-0.6558,0.6558,"Não"],["Prophet/UC","sigma2.seasonal",233.6597,48.2405,0,139.1082,328.2111,"Sim"],["Prophet/UC","beta.x1",-0.0102,0.0805,0.8995,-0.168,0.1477,"Não"],["Prophet/UC","beta.x2",2.5165,120175.0993,1,-235540.6781,235545.7111,"Não"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.0595,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.3442,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],