ivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1881,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0822,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0628,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0634,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1366,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.2248,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1455,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0568,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0328,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.007,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.114·ARIMA + 0.135·SARIMAX-12 + 0.139·SARIMAX-6 + 0.140·Holt-Winters + 0.132·Prophet/UC + 0.139·Theta + 0.200·GradientBoosting. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1141,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1351,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1394,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1404,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.1316,"—","—","—","—",""],["Ensemble","peso_Theta",0.139,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.2005,"—","—","—","—",""]]
