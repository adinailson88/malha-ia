het/UC","AIC",1129.51,"","","","",""],["Prophet/UC","BIC",1152.14,"","","","",""],["Prophet/UC","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",1129.5127,"—","—","—","—",""],["Prophet/UC","BIC",1152.1392,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",142.397,38.623,0.0002,66.696,218.098,"Sim"],["Prophet/UC","sigma2.level",88.9776,33.6922,0.0083,22.941,155.0143,"Sim"],["Prophet/UC","sigma2.trend",0,0.114,1,-0.2234,0.2234,"Não"],["Prophet/UC","sigma2.seasonal",6.0567,5.8303,0.2989,-5.3706,17.484,"Não"],["Prophet/UC","beta.x1",-0.0105,0.0535,0.8445,-0.1154,0.0944,"Não"],["Prophet/UC","beta.x2",0.9311,58631.1023,1,-114916.0293,114917.8916,"Não"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.5473,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.4972,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (ch