lhança.","","","","",""],["Prophet/UC","Configuração","UnobservedComponents(LLT + seasonal=12 + exog)","","","","",""],["Prophet/UC","AIC",854.91,"","","","",""],["Prophet/UC","BIC",877.35,"","","","",""],["Prophet/UC","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",854.915,"—","—","—","—",""],["Prophet/UC","BIC",877.3471,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",24.6711,4.7317,0,15.3969,33.9453,"Sim"],["Prophet/UC","sigma2.level",8.9192,2.8187,0.0016,3.3946,14.4438,"Sim"],["Prophet/UC","sigma2.trend",0,0.0112,1,-0.022,0.022,"Não"],["Prophet/UC","sigma2.seasonal",0,0.4826,1,-0.9458,0.9458,"Não"],["Prophet/UC","beta.x1",0.0105,0.0127,0.4062,-0.0143,0.0354,"Não"],["Prophet/UC","beta.x2",-0.1878,164665.8125,1,-322745.1802,322744.8046,"Não"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.0859,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.418,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configura