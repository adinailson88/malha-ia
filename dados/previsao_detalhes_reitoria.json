,1,2)(1,1,1)[6]+exog","","","","",""],["SARIMAX-6","AIC",850.89,"","","","",""],["SARIMAX-6","BIC",876.05,"","","","",""],["SARIMAX-6","Usa exógenas (chuva, letivo)","Sim","","","","",""],["SARIMAX-6","x1",-0.0011,0.0121,0.9285,-0.0248,0.0226,"Não"],["SARIMAX-6","x2",2.8401,3.603,0.4305,-4.2218,9.9021,"Não"],["SARIMAX-6","const",0,0.0002,1,-0.0004,0.0004,"Não"],["SARIMAX-6","x3",0,0.0002,1,-0.0003,0.0003,"Não"],["SARIMAX-6","ma.L1",-0.5911,0.0829,0,-0.7536,-0.4287,"Sim"],["SARIMAX-6","ma.L2",0.02,0.101,0.8429,-0.1779,0.218,"Não"],["SARIMAX-6","ar.S.L6",-0.2226,0.0895,0.0129,-0.3981,-0.0471,"Sim"],["SARIMAX-6","ma.S.L6",-1,260.2845,0.9969,-511.1576,509.1577,"Não"],["SARIMAX-6","sigma2",49.8872,12984.0387,0.9969,-25398.8286,25498.603,"Não"],["","","","","","","",""],["Holt-Winters","EQUAÇÃO","Holt-Winters Aditivo: ℓ(t) = α·y(t) + (1-α)·[ℓ(t-1) + b(t-1)]; b(t) = β·[ℓ(t)-ℓ(t-1)] + (1-β)·b(t-1); s(t) = γ·[y(t)-ℓ(t)] + (1-γ)·s(t-12). Forecast: ŷ(t+h) = ℓ(t) + h·b(t) + s(t-12+h).","","","","",""],["Holt-Winters","Configuração","HW(α=0.424,β=0.000,γ=0.000)","","","","",""],["Holt-Winters","AIC",547.34,"","","","",""],["Holt-Winters","BIC",594.06,"","","","",""],["Holt-Winters","Usa exógenas (chuva, letivo)","Não","","","","",""],["Holt-Winters","α (suavização nível)",0.4243,"—","—","—","—",""],["Holt-Winters","β (suavização tendência)",0,"—","—","—","—",""],["Holt-Winters","γ (suavização sazonal)",0,"—","—","—","—",""],["Holt-Winters","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["Prophet/UC","EQUAÇÃO","UnobservedComponents (Harvey, 1989) — fallback ativado por indisponibilidade do Prophet/cmdstanpy. y(t) = μ(t) + γ(t) + β·X(t) + ε(t), onde μ(t) é tendência local linear (level + slope), γ(t) é sazonalidade trigonométrica de período 12, β·X(t) são regressores exógenos (precipitação, letivo) e ε(t) ~ N(0,σ²). Estimação por filtro de Kalman e máxima verossimilhança.","","","","",""],["Prophet/UC","Configuração","UnobservedComponents(LLT + seasonal=12 + exog)","","","","",""],["Prophet/UC","AIC",876.18,"","","","",""],["Prophet/UC","BIC",898.74,"","","","",""],["Prophet/UC","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",876.1786,"—","—","—","—",""],["Prophet/UC","BIC",898.7408,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",27.1265,4.7479,0,17.8206,36.4325,"Sim"],["Prophet/UC","sigma2.level",8.7475,2.7711,0.0016,3.3161,14.1789,"Sim"],["Prophet/UC","sigma2.trend",0,0.0111,1,-0.0217,0.0217,"Não"],["Prophet/UC","sigma2.seasonal",0,0.4836,1,-0.9478,0.9478,"Não"],["Prophet/UC","beta.x1",-0.0021,0.0122,0.8645,-0.026,0.0218,"Não"],["Prophet/UC","beta.x2",-0.1337,164547.6865,1,-322513.5993,322513.332,"Não"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.083,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.4137,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.09,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0886,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0878,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0873,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.168,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1539,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1745,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0849,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0571,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0079,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.139·ARIMA + 0.124·SARIMAX-12 + 0.133·SARIMAX-6 + 0.134·Holt-Winters + 0.128·Prophet/UC + 0.143·Theta + 0.074·GradientBoosting + 0.125·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1386,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1242,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1331,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1344,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.1282,"—","—"