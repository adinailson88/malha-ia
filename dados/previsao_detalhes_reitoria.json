 exog)","","","","",""],["Prophet/UC","AIC",888.66,"","","","",""],["Prophet/UC","BIC",911.35,"","","","",""],["Prophet/UC","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",888.659,"—","—","—","—",""],["Prophet/UC","BIC",911.3493,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",26.7439,4.6041,0,17.7198,35.768,"Sim"],["Prophet/UC","sigma2.level",8.8015,2.8134,0.0018,3.2871,14.3158,"Sim"],["Prophet/UC","sigma2.trend",0,0.0109,1,-0.0214,0.0214,"Não"],["Prophet/UC","sigma2.seasonal",0,0.4581,1,-0.8979,0.8979,"Não"],["Prophet/UC","beta.x1",-0.0034,0.0141,0.8086,-0.0312,0.0243,"Não"],["Prophet/UC","beta.x2",-0.0845,166663.3504,1,-326660.2514,326660.0824,"Não"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.0841,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.4153,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.0965,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0888,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0897,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0861,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1668,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1463,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1775,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0853,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0532,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0098,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.135·ARIMA + 0.130·SARIMAX-12 + 0.146·SARIMAX-6 + 0.128·Holt-Winters + 0.128·Prophet/UC + 0.132·Theta + 0.201·GradientBoosting. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1351,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1302,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1457,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1282,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.1283,"—","—","—","—",""],["Ensemble","peso_Theta",0.1319,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.2006,"—","—","—","—",""]]
