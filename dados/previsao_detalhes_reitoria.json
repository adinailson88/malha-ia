 exog)","","","","",""],["Prophet/UC","AIC",876.14,"","","","",""],["Prophet/UC","BIC",898.7,"","","","",""],["Prophet/UC","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",876.1412,"—","—","—","—",""],["Prophet/UC","BIC",898.7034,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",27.0229,4.7224,0,17.767,36.2789,"Sim"],["Prophet/UC","sigma2.level",8.827,2.7671,0.0014,3.4034,14.2505,"Sim"],["Prophet/UC","sigma2.trend",0,0.011,1,-0.0216,0.0216,"Não"],["Prophet/UC","sigma2.seasonal",0,0.4848,1,-0.9503,0.9503,"Não"],["Prophet/UC","beta.x1",0.0028,0.0117,0.8081,-0.0201,0.0258,"Não"],["Prophet/UC","beta.x2",-0.1627,163740.2412,1,-320931.0355,320930.7102,"Não"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.083,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.4137,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.0917,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0848,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0841,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0884,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1701,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1555,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1728,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0864,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.059,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0072,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.141·ARIMA + 0.120·SARIMAX-12 + 0.132·SARIMAX-6 + 0.137·Holt-Winters + 0.125·Prophet/UC + 0.145·Theta + 0.077·GradientBoosting + 0.124·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.141,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1197,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1317,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1367,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.1251,"—","—