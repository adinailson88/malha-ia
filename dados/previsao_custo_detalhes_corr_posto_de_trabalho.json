b & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.0717,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0507,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.1019,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1093,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1612,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.0591,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1358,"—","—","—","—",""],["GradientBoosting","importância_mes",0.1611,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.1355,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0138,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.150·ARIMA + 0.134·SARIMAX-12 + 0.141·SARIMAX-6 + 0.142·Holt-Winters + 0.052·Prophet/UC + 0.168·Theta + 0.212·GradientBoosting. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1503,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1342,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1406,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1421,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.0522,"—","—","—","—",""],["Ensemble","peso_Theta",0.1685,"—","—","—","—",""],["Ensemble","