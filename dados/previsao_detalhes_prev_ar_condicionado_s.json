[["Modelo","Parâmetro","Valor","Erro Padrão","p-valor","IC95% Inf","IC95% Sup","Significativo (p<0.05)"],["ARIMA","EQUAÇÃO","ARIMA(3,1,3): y(t) = c + φ_1·y(t-1) + φ_2·y(t-2) + φ_3·y(t-3) + θ_1·ε(t-1) + θ_2·ε(t-2) + θ_3·ε(t-3) + ε(t) [após 1 diferenciação(ões) ordinária(s)]","","","","",""],["ARIMA","Configuração","ARIMA(3,1,3)","","","","",""],["ARIMA","AIC",805.64,"","","","",""],["ARIMA","BIC",823.87,"","","","",""],["ARIMA","Usa exógenas (chuva, letivo)","Não","","","","",""],["ARIMA","ar.L1",-0.4423,0.1476,0.0027,-0.7315,-0.153,"Sim"],["ARIMA","ar.L2",-0.3698,0.1614,0.0219,-0.6861,-0.0535,"Sim"],["ARIMA","ar.L3",0.6296,0.1583,0.0001,0.3194,0.9399,"Sim"],["ARIMA","ma.L1",0.0697,281.7128,0.9998,-552.0874,552.2268,"Não"],["ARIMA","ma.L2",-0.0698,258.6359,0.9998,-506.9962,506.8566,"Não"],["ARIMA","ma.L3",-1,435.0485,0.9982,-853.6951,851.695,"Não"],["ARIMA","sigma2",145.343,63228.2711,0.9982,-123782.0684,124072.7545,"Não"],["","","","","","","",""],["Holt-Winters","EQUAÇÃO","Holt-Winters Aditivo: ℓ(t) = α·y(t) + (1-α)·[ℓ(t-1) + b(t-1)]; b(t) = β·[ℓ(t)-ℓ(t-1)] + (1-β)·b(t-1); s(t) = γ·[y(t)-ℓ(t)] + (1-γ)·s(t-12). Forecast: ŷ(t+h) = ℓ(t) + h·b(t) + s(t-12+h).","","","","",""],["Holt-Winters","Configuração","HW(α=0.447,β=0.000,γ=0.417)","","","","",""],["Holt-Winters","AIC",566.21,"","","","",""],["Holt-Winters","BIC",608.67,"","","","",""],["Holt-Winters","Usa exógenas (chuva, letivo)","Não","","","","",""],["Holt-Winters","α (suavização nível)",0.4471,"—","—","—","—",""],["Holt-Winters","β (suavização tendência)",0,"—","—","—","—",""],["Holt-Winters","γ (suavização sazonal)",0.417,"—","—","—","—",""],["Holt-Winters","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.0801,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.7015,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.290·ARIMA + 0.198·Holt-Winters + 0.149·Theta + 0.362·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.2902,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1985,"—","—","—","—",""],["Ensemble","peso_Theta",0.1488,"—","—","—","—",""],["Ensemble","peso_LSTM_Forecast",0.3625,"—","—","—","—",""]]
