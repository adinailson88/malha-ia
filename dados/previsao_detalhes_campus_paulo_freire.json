, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",1025.0354,"—","—","—","—",""],["Prophet/UC","BIC",1047.3353,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",58.1788,19.4512,0.0028,20.0546,96.3031,"Sim"],["Prophet/UC","sigma2.level",39.2082,9.6568,0,20.2808,58.1356,"Sim"],["Prophet/UC","sigma2.trend",0,0.0839,1,-0.1645,0.1645,"Não"],["Prophet/UC","sigma2.seasonal",21.6749,6.4884,0.0008,8.9576,34.3921,"Sim"],["Prophet/UC","beta.x1",-0.0032,0.05,0.9496,-0.1011,0.0948,"Não"],["Prophet/UC","beta.x2",1.888,262775.7826,1,-515038.6458,515042.4219,"Não"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.2199,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.5315,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1357,"—","—","—","—",""],["GradientBoostin