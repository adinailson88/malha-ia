as (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",1024.8855,"—","—","—","—",""],["Prophet/UC","BIC",1047.1855,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",59.5956,19.7228,0.0025,20.9391,98.2522,"Sim"],["Prophet/UC","sigma2.level",39.0463,9.9983,0.0001,19.4496,58.6431,"Sim"],["Prophet/UC","sigma2.trend",0,0.0876,1,-0.1716,0.1716,"Não"],["Prophet/UC","sigma2.seasonal",20.9372,6.3785,0.001,8.4353,33.439,"Sim"],["Prophet/UC","beta.x1",-0.012,0.0815,0.8826,-0.1718,0.1477,"Não"],["Prophet/UC","beta.x2",1.9439,260257.1465,1,-510102.0632,510105.9509,"Não"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.2199,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.5315,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1364,"—","—","—","—",""],["G