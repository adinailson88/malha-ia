 letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",1024.792,"—","—","—","—",""],["Prophet/UC","BIC",1047.0919,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",60.066,19.7905,0.0024,21.2766,98.8553,"Sim"],["Prophet/UC","sigma2.level",38.9031,10.0759,0.0001,19.1544,58.6518,"Sim"],["Prophet/UC","sigma2.trend",0,0.0889,1,-0.1742,0.1742,"Não"],["Prophet/UC","sigma2.seasonal",20.7192,6.3421,0.0011,8.2887,33.1498,"Sim"],["Prophet/UC","beta.x1",-0.0151,0.0839,0.8568,-0.1796,0.1493,"Não"],["Prophet/UC","beta.x2",1.9506,253281.7348,1,-496430.2497,496434.1509,"Não"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.2199,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.5315,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.136,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0973,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.071,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.09,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1715,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.097,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.2553,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0711,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0038,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0069,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.104·ARIMA + 0.138·SARIMAX-12 + 0.113·SARIMAX-6 + 0.130·Holt-Winters + 0.118·Prophet/UC + 0.127·Theta + 0.176·GradientBoosting + 0.093·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1039,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1378,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1133,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.13,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.1185,"—","—","—","—",""],["Ensemble","peso_Theta",0.1273,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.176,"—","—","—","—","