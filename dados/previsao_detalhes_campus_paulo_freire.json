,1,2)(0,1,1)[6]+exog","","","","",""],["SARIMAX-6","AIC",915.35,"","","","",""],["SARIMAX-6","BIC",937.24,"","","","",""],["SARIMAX-6","Usa exógenas (chuva, letivo)","Sim","","","","",""],["SARIMAX-6","x1",0.0045,0.0359,0.9001,-0.0658,0.0748,"Não"],["SARIMAX-6","x2",4.3912,5.952,0.4607,-7.2747,16.0572,"Não"],["SARIMAX-6","const",0,0,1,0,0,"Não"],["SARIMAX-6","x3",0,0,1,0,0,"Não"],["SARIMAX-6","ma.L1",-0.3131,0.0992,0.0016,-0.5075,-0.1186,"Sim"],["SARIMAX-6","ma.L2",-0.2299,0.077,0.0028,-0.3808,-0.0791,"Sim"],["SARIMAX-6","ma.S.L6",-0.8744,0.0812,0,-1.0336,-0.7152,"Sim"],["SARIMAX-6","sigma2",149.3817,13.1402,0,123.6268,175.1365,"Sim"],["","","","","","","",""],["Holt-Winters","EQUAÇÃO","Holt-Winters Aditivo: ℓ(t) = α·y(t) + (1-α)·[ℓ(t-1) + b(t-1)]; b(t) = β·[ℓ(t)-ℓ(t-1)] + (1-β)·b(t-1); s(t) = γ·[y(t)-ℓ(t)] + (1-γ)·s(t-12). Forecast: ŷ(t+h) = ℓ(t) + h·b(t) + s(t-12+h).","","","","",""],["Holt-Winters","Configuração","HW(α=0.581,β=0.000,γ=0.000)","","","","",""],["Holt-Winters","AIC",651.04,"","","","",""],["Holt-Winters","BIC",696.92,"","","","",""],["Holt-Winters","Usa exógenas (chuva, letivo)","Não","","","","",""],["Holt-Winters","α (suavização nível)",0.5806,"—","—","—","—",""],["Holt-Winters","β (suavização tendência)",0,"—","—","—","—",""],["Holt-Winters","γ (suavização sazonal)",0,"—","—","—","—",""],["Holt-Winters","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["Prophet/UC","EQUAÇÃO","UnobservedComponents (Harvey, 1989) — fallback ativado por indisponibilidade do Prophet/cmdstanpy. y(t) = μ(t) + γ(t) + β·X(t) + ε(t), onde μ(t) é tendência local linear (level + slope), γ(t) é sazonalidade trigonométrica de período 12, β·X(t) são regressores exógenos (precipitação, letivo) e ε(t) ~ N(0,σ²). Estimação por filtro de Kalman e máxima verossimilhança.","","","","",""],["Prophet/UC","Configuração","UnobservedComponents(LLT + seasonal=12 + exog)","","","","",""],["Prophet/UC","AIC",1001.08,"","","","",""],["Prophet/UC","BIC",1023.18,"","","","","