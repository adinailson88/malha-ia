SARIMAX(0,1,2)(0,1,1)[6]+exog","","","","",""],["SARIMAX-6","AIC",918.85,"","","","",""],["SARIMAX-6","BIC",940.81,"","","","",""],["SARIMAX-6","Usa exógenas (chuva, letivo)","Sim","","","","",""],["SARIMAX-6","x1",-0.0027,0.0223,0.9039,-0.0465,0.0411,"Não"],["SARIMAX-6","x2",4.2861,5.8144,0.461,-7.1102,15.6823,"Não"],["SARIMAX-6","const",0,"—","—","—","—",""],["SARIMAX-6","x3",0,0,1,0,0,"Não"],["SARIMAX-6","ma.L1",-0.3395,0.0912,0.0002,-0.5183,-0.1608,"Sim"],["SARIMAX-6","ma.L2",-0.2249,0.0734,0.0022,-0.3687,-0.081,"Sim"],["SARIMAX-6","ma.S.L6",-0.8906,0.0837,0,-1.0546,-0.7265,"Sim"],["SARIMAX-6","sigma2",143.0336,12.645,0,118.2493,167.8179,"Sim"],["","","","","","","",""],["Holt-Winters","EQUAÇÃO","Holt-Winters Aditivo: ℓ(t) = α·y(t) + (1-α)·[ℓ(t-1) + b(t-1)]; b(t) = β·[ℓ(t)-ℓ(t-1)] + (1-β)·b(t-1); s(t) = γ·[y(t)-ℓ(t)] + (1-γ)·s(t-12). Forecast: ŷ(t+h) = ℓ(t) + h·b(t) + s(t-12+h).","","","","",""],["Holt-Winters","Configuração","HW(α=0.546,β=0.000,γ=0.000)","","","","",""],["Holt-Winters","AIC",650.76,"","","","",""],["Holt-Winters","BIC",696.76,"","","","",""],["Holt-Winters","Usa exógenas (chuva, letivo)","Não","","","","",""],["Holt-Winters","α (suavização nível)",0.5456,"—","—","—","—",""],["Holt-Winters","β (suavização tendência)",0,"—","—","—","—",""],["Holt-Winters","γ (suavização sazonal)",0,"—","—","—","—",""],["Holt-Winters","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["Prophet/UC","EQUAÇÃO","UnobservedComponents (Harvey, 1989) — fallback ativado por indisponibilidade do Prophet/cmdstanpy. y(t) = μ(t) + γ(t) + β·X(t) + ε(t), onde μ(t) é tendência local linear (level + slope), γ(t) é sazonalidade trigonométrica de período 12, β·X(t) são regressores exógenos (precipitação, letivo) e ε(t) ~ N(0,σ²). Estimação por filtro de Kalman e máxima verossimilhança.","","","","",""],["Prophet/UC","Configuração","UnobservedComponents(LLT + seasonal=12 + exog)","","","","",""],["Prophet/UC","AIC",1010.98,"","","","",""],["Prophet/UC","BIC",1033.15,"","","","",""],["Prophet/UC","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",1010.9848,"—","—","—","—",""],["Prophet/UC","BIC",1033.1503,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",61.0993,19.2322,0.0015,23.4042,98.7945,"Sim"],["Prophet/UC","sigma2.level",39.8115,9.8784,0.0001,20.4499,59.1732,"Sim"],["Prophet/UC","sigma2.trend",0,0.0844,1,-0.1655,0.1655,"Não"],["Prophet/UC","sigma2.seasonal",21.5071,6.7218,0.0014,8.3325,34.6818,"Sim"],["Prophet/UC","beta.x1",0.0059,0.0389,0.8796,-0.0704,0.0822,"Não"],["Prophet/UC","beta.x2",1.7369,261435.5494,1,-512411.94,512415.4138,"Não"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.2147,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.5517,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1306,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0969,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0679,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0864,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1741,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.0917,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.2587,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0709,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0153,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0076,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.113·ARIMA + 0.170·SARIMAX-12 + 0.120·SARIMAX-6 + 0.145·Holt-Winters + 0.095·Prophet/UC + 0.144·Theta + 0.085·GradientBoosting + 0.128·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1135,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1697,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1199,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1446,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.0952,"—","—","—","—",""],["Ensemble","peso_Theta",0.1442,"—","—","—","—",""],["