as (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1438,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.1106,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0706,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0938,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1605,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.0925,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.2509,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0635,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0056,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0083,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.134·ARIMA + 0.152·SARIMAX-12 + 0.139·SARIMAX-6 + 0.152·Holt-Winters + 0.201·Prophet/UC + 0.143·Theta + 0.079·GradientBoosting. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1343,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1516,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1386,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1523,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.2007,"—","—","—","—",""],["Ensemble","peso_Theta",0.1431,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.0794,"—","—","—","—",""]]
