,2)(0,1,1)[6]+exog","","","","",""],["SARIMAX-6","AIC",950.18,"","","","",""],["SARIMAX-6","BIC",972.35,"","","","",""],["SARIMAX-6","Usa exógenas (chuva, letivo)","Sim","","","","",""],["SARIMAX-6","x1",0.0189,0.0188,0.3131,-0.0179,0.0557,"Não"],["SARIMAX-6","x2",4.6411,6.3137,0.4623,-7.7338,17.016,"Não"],["SARIMAX-6","const",0,"—","—","—","—",""],["SARIMAX-6","x3",0,"—","—","—","—",""],["SARIMAX-6","ma.L1",-0.4031,0.0842,0,-0.5681,-0.238,"Sim"],["SARIMAX-6","ma.L2",-0.1757,0.0884,0.0467,-0.3489,-0.0025,"Sim"],["SARIMAX-6","ma.S.L6",-0.8683,0.0759,0,-1.0171,-0.7194,"Sim"],["SARIMAX-6","sigma2",154.11,11.2206,0,132.1176,176.1025,"Sim"],["","","","","","","",""],["Holt-Winters","EQUAÇÃO","Holt-Winters Aditivo: ℓ(t) = α·y(t) + (1-α)·[ℓ(t-1) + b(t-1)]; b(t) = β·[ℓ(t)-ℓ(t-1)] + (1-β)·b(t-1); s(t) = γ·[y(t)-ℓ(t)] + (1-γ)·s(t-12). Forecast: ŷ(t+h) = ℓ(t) + h·b(t) + s(t-12+h).","","","","",""],["Holt-Winters","Configuração","HW(α=0.500,β=0.000,γ=0.000)","","","","",""],["Holt-Winters","AIC",674.27,"","","","",""],["Holt-Winters","BIC",720.64,"","","","",""],["Holt-Winters","Usa exógenas (chuva, letivo)","Não","","","","",""],["Holt-Winters","α (suavização nível)",0.5002,"—","—","—","—",""],["Holt-Winters","β (suavização tendência)",0,"—","—","—","—",""],["Holt-Winters","γ (suavização sazonal)",0,"—","—","—","—",""],["Holt-Winters","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["Prophet/UC","EQUAÇÃO","UnobservedComponents (Harvey, 1989) — fallback ativado por indisponibilidade do Prophet/cmdstanpy. y(t) = μ(t) + γ(t) + β·X(t) + ε(t), onde μ(t) é tendência local linear (level + slope), γ(t) é sazonalidade trigonométrica de período 12, β·X(t) são regressores exógenos (precipitação, letivo) e ε(t) ~ N(0,σ²). Estimação por filtro de Kalman e máxima verossimilhança.","","","","",""],["Prophet/UC","Configuração","UnobservedComponents(LLT + seasonal=12 + exog)","","","","",""],["Prophet/UC","AIC",1029.43,"","","","",""],["Prophet/UC","BIC",1051.8,"","","","","