=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1674,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0922,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.081,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1118,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1738,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1281,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1039,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0837,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0541,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.004,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.123·ARIMA + 0.126·SARIMAX-12 + 0.112·SARIMAX-6 + 0.165·Holt-Winters + 0.160·Prophet/UC + 0.170·Theta + 0.060·GradientBoosting + 0.084·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.123,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1256,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1117,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1654,"—","—","