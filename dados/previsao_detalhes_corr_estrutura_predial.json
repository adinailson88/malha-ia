)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1723,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0914,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0862,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.11,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.1713,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1297,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1029,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0862,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0464,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0037,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.120·ARIMA + 0.122·SARIMAX-12 + 0.112·SARIMAX-6 + 0.165·Holt-Winters + 0.161·Prophet/UC + 0.170·Theta + 0.061·GradientBoosting + 0.090·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1199,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1216,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1122,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1647,"—","—","—","