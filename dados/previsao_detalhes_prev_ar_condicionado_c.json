onents (Harvey, 1989) — fallback ativado por indisponibilidade do Prophet/cmdstanpy. y(t) = μ(t) + γ(t) + β·X(t) + ε(t), onde μ(t) é tendência local linear (level + slope), γ(t) é sazonalidade trigonométrica de período 12, β·X(t) são regressores exógenos (precipitação, letivo) e ε(t) ~ N(0,σ²). Estimação por filtro de Kalman e máxima verossimilhança.","","","","",""],["Prophet/UC","Configuração","UnobservedComponents(LLT + seasonal=12 + exog)","","","","",""],["Prophet/UC","AIC",423.17,"","","","",""],["Prophet/UC","BIC",441.81,"","","","",""],["Prophet/UC","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",423.1681,"—","—","—","—",""],["Prophet/UC","BIC",441.8139,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",4.8378,1.0631,0,2.754,6.9215,"Sim"],["Prophet/UC","sigma2.level",0.0317,0.108,0.7693,-0.1799,0.2433,"Não"],["Prophet/UC","sigma2.trend",0,0.0003,1,-0.0006,0.0006,"Não"],["Prophet/UC","sigma2.seasonal",1.8455,0.5924,0.0018,0.6845,3.0065,"Sim"],["Prophet/UC","beta.x1",-0.0026,0.013,0.8391,-0.0281,0.0228,"Não"],["Prophet/UC","beta.x2",0.6195,0,0,0.6195,0.6195,"Sim"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",-0.0123,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.0758,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.0514,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0814,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0517,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.086,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.0947,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1187,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1813,"—","—","—","—",""],["GradientBoosting","importância_mes",0.2483,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0694,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.017,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.152·ARIMA + 0.134·SARIMAX-12 + 0.137·SARIMAX-6 + 0.135·Holt-Winters + 0.085·Prophet/UC + 0.100·Theta + 0.108·GradientBoosting + 0.150·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1517,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1344,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1367,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1347,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.0851,"—","—","—","—",""],["Ensemble","peso_Theta",0.0996,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.1078,"—","—","—","—",""],["Ensemble","peso_LSTM_Forecast",0.15,"—","—","—","—",""]]
