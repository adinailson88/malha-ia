ina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.0551,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0861,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0568,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0851,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.0952,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1415,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1786,"—","—","—","—",""],["GradientBoosting","importância_mes",0.2573,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0272,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0171,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.180·ARIMA + 0.152·SARIMAX-12 + 0.150·SARIMAX-6 + 0.160·Holt-Winters + 0.103·Prophet/UC + 0.118·Theta + 0.135·GradientBoosting. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1802,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1524,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1504,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1599,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.1034,"—","—","—","—",""],["Ensemble","peso_Theta",0.1183,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.1354,"—","—","—","—",""]]
