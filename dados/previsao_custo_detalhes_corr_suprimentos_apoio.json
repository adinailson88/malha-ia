as X = [Precipitação_mm, Período_Letivo]: combinação de componentes AR/MA não-sazonais e sazonais com diferenciação ordinária (1) e sazonal (1), regredida sobre X.","","","","",""],["SARIMAX-6","Configuração","SARIMAX(0,1,2)(1,1,1)[6]+exog","","","","",""],["SARIMAX-6","AIC",1548.94,"","","","",""],["SARIMAX-6","BIC",1570.49,"","","","",""],["SARIMAX-6","Usa exógenas (chuva, letivo)","Sim","","","","",""],["SARIMAX-6","x1",2.1343,9.9821,0.8307,-17.4307,21.6993,"Não"],["SARIMAX-6","x2",801.2,2945.3757,0.7856,-4971.7363,6574.1363,"Não"],["SARIMAX-6","const",0,0,1,0,0,"Não"],["SARIMAX-6","x3",0,0,1,0,0,"Não"],["SARIMAX-6","ma.L1",-0.8929,0.2157,0,-1.3156,-0.4701,"Sim"],["SARIMAX-6","ma.L2",-0.0529,0.1584,0.7382,-0.3634,0.2575,"Não"],["SARIMAX-6","ar.S.L6",0.0262,0.1863,0.8882,-0.3389,0.3913,"Não"],["SARIMAX-6","ma.S.L6",-1.1237,0.044,0,-1.21,-1.0374,"Sim"],["SARIMAX-6","sigma2",7609977.8028,1.2871,0,7609975.2801,7609980.3254,"Sim"],["","","","","","","",""],["Holt-Winters","EQUAÇÃO","Holt-Winters Aditivo: ℓ(t) = α·y(t) + (1-α)·[ℓ(t-1) + b(t-1)]; b(t) = β·[ℓ(t)-ℓ(t-1)] + (1-β)·b(t-1); s(t) = γ·[y(t)-ℓ(t)] + (1-γ)·s(t-12). Forecast: ŷ(t+h) = ℓ(t) + h·b(t) + s(t-12+h).","","","","",""],["Holt-Winters","Configuração","HW(α=0.076,β=0.076,γ=0.000)","","","","",""],["Holt-Winters","AIC",1597.07,"","","","",""],["Holt-Winters","BIC",1638.26,"","","","",""],["Holt-Winters","Usa exógenas (chuva, letivo)","Não","","","","",""],["Holt-Winters","α (suavização nível)",0.0757,"—","—","—","—",""],["Holt-Winters","β (suavização tendência)",0.0757,"—","—","—","—",""],["Holt-Winters","γ (suavização sazonal)",0.0001,"—","—","—","—",""],["Holt-Winters","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["Prophet/UC","EQUAÇÃO","UnobservedComponents (Harvey, 1989) — fallback ativado por indisponibilidade do Prophet/cmdstanpy. y(t) = μ(t) + γ(t) + β·X(t) + ε(t), onde μ(t) é tendência local linear (level + slope), γ(t) é sazonalidade trigonométrica de período 12, β·X(t) são reg