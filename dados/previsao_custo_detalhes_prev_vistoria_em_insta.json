ão por filtro de Kalman e máxima verossimilhança.","","","","",""],["Prophet/UC","Configuração","UnobservedComponents(LLT + seasonal=12 + exog)","","","","",""],["Prophet/UC","AIC",1946.07,"","","","",""],["Prophet/UC","BIC",1964.72,"","","","",""],["Prophet/UC","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Prophet/UC","modelo","NaN","—","—","—","—",""],["Prophet/UC","AIC",1946.0743,"—","—","—","—",""],["Prophet/UC","BIC",1964.7202,"—","—","—","—",""],["Prophet/UC","sigma2.irregular",2724087239.8915,1414483784.0155,0.0541,-48300976.779,5496475456.5619,"Não"],["Prophet/UC","sigma2.level",6240445.1216,159257935.2042,0.9687,-305905107.8787,318385998.1219,"Não"],["Prophet/UC","sigma2.trend",236.5888,314583.8334,0.9994,-616347.7247,616820.9022,"Não"],["Prophet/UC","sigma2.seasonal",2440935356.9631,1101197372.6254,0.0266,282588506.6173,4599282207.3089,"Sim"],["Prophet/UC","beta.x1",-69.0656,826.5991,0.9334,-1689.1998,1551.0686,"Não"],["Prophet/UC","beta.x2",3491.1548,153896.013,0.9819,-298145.0307,305127.3403,"Não"],["Prophet/UC","beta.const",0,0,"—",0,0,""],["Prophet/UC","beta.x3",0,0,"—",0,0,""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",-4.5118,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.0872,"—","—","—","—",""],["Theta","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["GradientBoosting","EQUAÇÃO","Gradient Boosting com forecast DIRETO multi-step (Bontempi, Taieb & Le Borgne, 2013): para cada horizonte h ∈ {1,...,12}, treina-se modelo independente ŷ(t+h) = F_h(x_t), onde F_h = Σⱼ γⱼ·hⱼ(x). Total: 12 modelos especializados. Features: lag_1..lag_12, médias móveis, mês, precipitação, letivo, área construída m², área total m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1103,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.1146,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.121,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0828,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.0189,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.0203,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.0557,"—","—","—","—",""],["GradientBoosting","importância_mes",0.1746,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.2714,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0302,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.090·ARIMA + 0.027·SARIMAX-12 + 0.040·SARIMAX-6 + 0.032·Holt-Winters + 0.001·Prophet/UC + 0.156·Theta + 0.272·GradientBoosting + 0.382·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.0904,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.0267,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.0404,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.0322,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.0006,"—","—","—","—",""],["Ensemble","peso_Theta",0.1558,"—","—","—","—",""],["Ensemble","peso_GradientBoosting",0.2721,"—","—","—","—",""],["Ensemble","peso_LSTM_Forecast",0.3818,"—","—","—","—",""]]
