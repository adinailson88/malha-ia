al m² [v3.8].","","","","",""],["GradientBoosting","Configuração","GBR-DIRECT(H=12, n=200, depth=3, lr=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.12,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.1062,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0982,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1067,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.0627,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1194,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1446,"—","—","—","—",""],["GradientBoosting","importância_mes",0.1241,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.1038,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0143,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.152·ARIMA + 0.141·SARIMAX-12 + 0.081·SARIMAX-6 + 0.119·Holt-Winters + 0.042·Prophet/UC + 0.148·Theta + 0.146·GradientBoosting + 0.171·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1516,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1408,"—","—","—","—",""],[