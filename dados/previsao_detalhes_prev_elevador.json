[["Modelo","Parâmetro","Valor","Erro Padrão","p-valor","IC95% Inf","IC95% Sup","Significativo (p<0.05)"],["ARIMA","EQUAÇÃO","ARIMA(3,1,3): y(t) = c + φ_1·y(t-1) + φ_2·y(t-2) + φ_3·y(t-3) + θ_1·ε(t-1) + θ_2·ε(t-2) + θ_3·ε(t-3) + ε(t) [após 1 diferenciação(ões) ordinária(s)]","","","","",""],["ARIMA","Configuração","ARIMA(3,1,3)","","","","",""],["ARIMA","AIC",303.33,"","","","",""],["ARIMA","BIC",320.51,"","","","",""],["ARIMA","Usa exógenas (chuva, letivo)","Não","","","","",""],["ARIMA","ar.L1",0.5972,0.1623,0.0002,0.279,0.9153,"Sim"],["ARIMA","ar.L2",-0.5632,0.1655,0.0007,-0.8876,-0.2388,"Sim"],["ARIMA","ar.L3",-0.4397,0.16,0.006,-0.7532,-0.1262,"Sim"],["ARIMA","ma.L1",-1.6223,399.2529,0.9968,-784.1579,780.9134,"Não"],["ARIMA","ma.L2",1.6563,1376.6798,0.999,-2696.6361,2699.9486,"Não"],["ARIMA","ma.L3",-0.8519,883.0259,0.9992,-1731.5827,1729.8789,"Não"],["ARIMA","sigma2",1.561,1618.1059,0.9992,-3169.9266,3173.0487,"Não"],["","","","","","","",""],["Holt-Winters","EQUAÇÃO","Holt-Winters Aditivo: ℓ(t) = α·y(t) + (1-α)·[ℓ(t-1) + b(t-1)]; b(t) = β·[ℓ(t)-ℓ(t-1)] + (1-β)·b(t-1); s(t) = γ·[y(t)-ℓ(t)] + (1-γ)·s(t-12). Forecast: ŷ(t+h) = ℓ(t) + h·b(t) + s(t-12+h).","","","","",""],["Holt-Winters","Configuração","HW(α=0.000,β=0.000,γ=0.000)","","","","",""],["Holt-Winters","AIC",91.85,"","","","",""],["Holt-Winters","BIC",132.03,"","","","",""],["Holt-Winters","Usa exógenas (chuva, letivo)","Não","","","","",""],["Holt-Winters","α (suavização nível)",0,"—","—","—","—",""],["Holt-Winters","β (suavização tendência)",0,"—","—","—","—",""],["Holt-Winters","γ (suavização sazonal)",0,"—","—","—","—",""],["Holt-Winters","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2