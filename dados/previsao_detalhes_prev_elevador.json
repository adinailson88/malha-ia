=0.05)","","","","",""],["GradientBoosting","Usa exógenas (chuva, letivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.1279,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.1048,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0967,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.1,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.0535,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.1351,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.1414,"—","—","—","—",""],["GradientBoosting","importância_mes",0.1273,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0982,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0151,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.152·ARIMA + 0.139·SARIMAX-12 + 0.132·SARIMAX-6 + 0.134·Holt-Winters + 0.049·Prophet/UC + 0.149·Theta + 0.084·GradientBoosting + 0.160·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.1521,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.1394,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1319,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1337,"—","—","