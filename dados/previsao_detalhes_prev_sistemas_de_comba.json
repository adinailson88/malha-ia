etivo)","Sim","","","","",""],["GradientBoosting","importância_lag_1",0.0945,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0758,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.074,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0631,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.0525,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.0386,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.104,"—","—","—","—",""],["GradientBoosting","importância_mes",0.3903,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0838,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0234,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.100·ARIMA + 0.140·SARIMAX-12 + 0.123·SARIMAX-6 + 0.119·Holt-Winters + 0.109·Prophet/UC + 0.120·Theta + 0.166·GradientBoosting + 0.124·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.0995,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.14,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.1225,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1194,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.1088,"—","—","—","—",""],