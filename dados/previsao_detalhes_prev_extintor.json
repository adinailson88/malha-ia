[["Modelo","Parâmetro","Valor","Erro Padrão","p-valor","IC95% Inf","IC95% Sup","Significativo (p<0.05)"],["ARIMA","EQUAÇÃO","ARIMA(0,1,3): y(t) = c + θ_1·ε(t-1) + θ_2·ε(t-2) + θ_3·ε(t-3) + ε(t) [após 1 diferenciação(ões) ordinária(s)]","","","","",""],["ARIMA","Configuração","ARIMA(0,1,3)","","","","",""],["ARIMA","AIC",265.79,"","","","",""],["ARIMA","BIC",276.09,"","","","",""],["ARIMA","Usa exógenas (chuva, letivo)","Não","","","","",""],["ARIMA","ma.L1",-1.0515,0.0964,0,-1.2404,-0.8626,"Sim"],["ARIMA","ma.L2",-0.0791,0.2223,0.7219,-0.5147,0.3565,"Não"],["ARIMA","ma.L3",0.1477,0.2197,0.5013,-0.2828,0.5783,"Não"],["ARIMA","sigma2",0.8104,0.0959,0,0.6225,0.9983,"Sim"],["","","","","","","",""],["Holt-Winters","EQUAÇÃO","Holt-Winters Aditivo: ℓ(t) = α·y(t) + (1-α)·[ℓ(t-1) + b(t-1)]; b(t) = β·[ℓ(t)-ℓ(t-1)] + (1-β)·b(t-1); s(t) = γ·[y(t)-ℓ(t)] + (1-γ)·s(t-12). Forecast: ŷ(t+h) = ℓ(t) + h·b(t) + s(t-12+h).","","","","",""],["Holt-Winters","Configuração","HW(α=0.000,β=0.000,γ=0.000)","","","","",""],["Holt-Winters","AIC",-34.15,"","","","",""],["Holt-Winters","BIC",7.85,"","","","",""],["Holt-Winters","Usa exógenas (chuva, letivo)","Não","","","","",""],["Holt-Winters","α (suavização nível)",0,"—","—","—","—",""],["Holt-Winters","β (suavização tendência)",0,"—","—","—","—",""],["Holt-Winters","γ (suavização sazonal)",0,"—","—","—","—",""],["Holt-Winters","período sazonal",12,"—","—","—","—",""],["","","","","","","",""],["Theta","EQUAÇÃO","Theta Method (Assimakopoulos & Nikolopoulos, 2000): decompõe a série em duas linhas-θ — θ=0 captura tendência linear, θ=2 amplifica curvaturas locais. Forecast = média das duas linhas, extrapoladas via SES. Vencedor das competições M3 (1999) e consistentemente competitivo na M4 (2018).","","","","",""],["Theta","Configuração","Theta(period=12)","","","","",""],["Theta","Usa exógenas (chuva, letivo)","Não","","","","",""],["Theta","theta_0 (drift linear)",0.0027,"—","—","—","—",""],["Theta","alpha (suavização SES)",0.0756,"—","—","—","