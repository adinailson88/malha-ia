ncia_lag_1",0.1819,"—","—","—","—",""],["GradientBoosting","importância_lag_2",0.0813,"—","—","—","—",""],["GradientBoosting","importância_lag_3",0.0714,"—","—","—","—",""],["GradientBoosting","importância_lag_6",0.0435,"—","—","—","—",""],["GradientBoosting","importância_lag_12",0.0749,"—","—","—","—",""],["GradientBoosting","importância_mm_3",0.2428,"—","—","—","—",""],["GradientBoosting","importância_mm_6",0.2166,"—","—","—","—",""],["GradientBoosting","importância_mes",0.0624,"—","—","—","—",""],["GradientBoosting","importância_precipitacao",0.0173,"—","—","—","—",""],["GradientBoosting","importância_letivo",0.0079,"—","—","—","—",""],["GradientBoosting","importância_area_construida",0,"—","—","—","—",""],["GradientBoosting","importância_area_total",0,"—","—","—","—",""],["","","","","","","",""],["LSTM_Forecast","EQUAÇÃO","LSTM Forecast (v3.8): janela deslizante de 12 meses → LSTM(64) → Dense(32,ReLU) → Dense(12). Entrada x_t ∈ ℝ^5 = [y(t), precip, letivo, área_c, área_t]. Saída ŷ = W_out·h_12 + b_out ∈ ℝ^12. Perda: MSE.","","","","",""],["LSTM_Forecast","Configuração","LSTM(W=12,units=64)+exog4","","","","",""],["LSTM_Forecast","Usa exógenas (chuva, letivo)","Sim","","","","",""],["LSTM_Forecast","arquitetura","NaN","—","—","—","—",""],["","","","","","","",""],["Ensemble","EQUAÇÃO","Ensemble = 0.069·ARIMA + 0.269·SARIMAX-12 + 0.128·SARIMAX-6 + 0.159·Holt-Winters + 0.113·Prophet/UC + 0.150·Theta + 0.045·GradientBoosting + 0.067·LSTM_Forecast. Pesos ∝ 1/RMSE_holdout, normalizados.","","","","",""],["Ensemble","Configuração","Média ponderada por 1/RMSE","","","","",""],["Ensemble","Usa exógenas (chuva, letivo)","Sim","","","","",""],["Ensemble","peso_ARIMA",0.0689,"—","—","—","—",""],["Ensemble","peso_SARIMAX-12",0.2693,"—","—","—","—",""],["Ensemble","peso_SARIMAX-6",0.128,"—","—","—","—",""],["Ensemble","peso_Holt-Winters",0.1588,"—","—","—","—",""],["Ensemble","peso_Prophet/UC",0.113,"—","—","—","—",""],["Ensemble","peso_Theta",0.1502,"—","—","—","—",""],["En